<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Zielversion vor Live-Einsatz mit der vorhandenen Windows-Umgebung abgleichen
         (Projektregel: .NET 8 war nur ein Architekturvorschlag, keine Endvorgabe). -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiraDeviceAgent</RootNamespace>
    <AssemblyName>MiraDeviceAgent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI-Wrapper (ProtectedData), offizielles Microsoft-Paket. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
